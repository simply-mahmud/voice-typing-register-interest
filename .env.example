# Typomatic Backend API Origin
# All interest registrations are securely processed by the Typomatic control backend
# and synchronized into the central Appwrite database (`ustad_pro_db` -> `interest_requests`).
#
# Production Backend:
VITE_CONTROL_API_ORIGIN=https://voice-api.trustedsubstore.com
#
# Local Development (if running backend locally on port 8787):
# VITE_CONTROL_API_ORIGIN=http://127.0.0.1:8787

